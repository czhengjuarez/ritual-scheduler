# Copy to `.dev.vars` (gitignored) for local development.
# For production set with: npx wrangler secret put SESSION_SECRET

# Signs the anonymous session cookie (see worker/session.ts). Any long random
# string; rotating it signs everyone's anonymous workspace out. Generate one
# with:
#   openssl rand -base64 48
SESSION_SECRET=replace-me-with-a-long-random-string

# Gates /api/admin/* (see worker/adminAuth.ts). Pick any password for local dev.
# For production: npx wrangler secret put ADMIN_PASSWORD
ADMIN_PASSWORD=replace-me-with-a-local-dev-password
