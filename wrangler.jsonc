{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ritual-scheduler",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-06-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this, Cloudflare's Assets layer runs before the Worker and
    // serves the SPA's index.html for any path that isn't a literal static
    // file — including /api/* and /ics/* (no dot-extension), so those never
    // reach the Hono routes below. This forces those two prefixes to the
    // Worker first; everything else still falls through to the SPA fallback.
    "run_worker_first": ["/api/*", "/ics/*"]
  },
  "observability": {
    "enabled": true
  },
  // Google sign-in (PLAN.md §7, worker/auth.ts). The client id is public by
  // design (verification happens server-side against Google's JWKS), so it's
  // safe to commit — same value as TeamRitualAudit's, one OAuth client for
  // the whole suite. AUTH_ENABLED defaults off: anonymous sessions stay the
  // default experience even once credentials are configured.
  "vars": {
    "AUTH_ENABLED": "false",
    "GOOGLE_CLIENT_ID": "52380837328-frg30utb8vqc2bcmfn74ugnqonnfocpg.apps.googleusercontent.com"
  },
  // Anonymous session signing key (see worker/session.ts). Local dev: set in
  // .dev.vars (gitignored). Production: wrangler secret put SESSION_SECRET
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ritual-builder",
      "database_id": "b847296c-13e8-4973-9eea-5765831b4410",
      "migrations_dir": "db/migrations"
    }
  ],
  // Phase 6: embeddings (rituals + cadences share one index, distinguished by
  // a "type" metadata field) and cadence suggestion / balance / remix /
  // autofill. No local simulator for either binding — AI always proxies to
  // the real service regardless of this config; Vectorize needs remote:true
  // to do the same under `vite dev` (see worker/embeddings.ts).
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "ritual-builder-embeddings", "remote": true }]
  // Later phases (see PLAN.md §2, §8):
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "ritual-builder-assets" }]
}
